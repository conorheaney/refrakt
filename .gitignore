.claude/settings.local.json
.claude/worktrees/

# Python (tools/)
__pycache__/
*.pyc

# Blender autosave copies
*.blend1
*.blend2

# Logs
*.log
npm-debug.log*

# Environment files and keys
.env
.env.*
!.env.example
*.pem
*.key

# Editors and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Backup of the repository history from before it was re-initialised (git bundle)
*.bundle
